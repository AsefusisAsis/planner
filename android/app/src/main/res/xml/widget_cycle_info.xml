<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «cycle». Обновляется сразу при изменении данных (широковещание
     из WidgetBridgePlugin); updatePeriodMillis — только страховка. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_cycle"
    android:previewLayout="@layout/widget_cycle"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_cycle_description" />
