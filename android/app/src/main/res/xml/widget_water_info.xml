<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «water». Обновляется сразу при изменении данных (широковещание
     из WidgetBridgePlugin); updatePeriodMillis — только страховка. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_water"
    android:previewLayout="@layout/widget_water"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_water_description" />
