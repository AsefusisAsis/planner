<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Вода». Единственный интерактивный: кнопки добавляют воду, не
     открывая приложение.
     Фон и кнопки — ImageView с белой формой, которую провайдер тонирует
     цветом темы: у View в RemoteViews нельзя задать цветной фон, сохранив
     скругление. Прогресс — 10 сегментов вместо ProgressBar: так он красится
     на любом API и выглядит как в приложении. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/water_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_card"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- шапка: название + процент -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/water_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_water_label" />

            <TextView
                android:id="@+id/water_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- герой: крупное число + подпись на общей базовой линии -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/water_hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="34sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/water_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingBottom="4dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- сегментированный прогресс -->
        <LinearLayout
            android:id="@+id/water_segments"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="3dp" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
            <ImageView android:id="@+id/seg10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/widget_shape_seg" android:contentDescription="@null" />
        </LinearLayout>

        <!-- кнопки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <FrameLayout
                android:id="@+id/water_add250"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/water_add250_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_shape_btn"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/water_add250_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/widget_water_add250" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/water_add500"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/water_add500_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_shape_btn"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/water_add500_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/widget_water_add500" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
