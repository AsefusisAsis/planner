<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android 14+: объяснение, зачем приложению медданные.
                 Без этого системный экран разрешений Health Connect
                 отказывает в доступе. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- Виджет рабочего стола «Сегодня». exported=false: систему это не
             ограничивает (она доставляет APPWIDGET_UPDATE по регистрации
             провайдера), а сторонние приложения дёргать его не должны. -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:label="@string/widget_today_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Виджет «Вода» — интерактивный: свой action для кнопок +250/+500,
             они шлют широковещание сюда же и НЕ открывают приложение. -->
        <receiver
            android:name=".WaterWidgetProvider"
            android:label="@string/widget_water_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.asefusis.planner.WIDGET_WATER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <receiver
            android:name=".CycleWidgetProvider"
            android:label="@string/widget_cycle_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_cycle_info" />
        </receiver>

        <receiver
            android:name=".ShoppingWidgetProvider"
            android:label="@string/widget_shopping_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shopping_info" />
        </receiver>

        <!-- До Android 14 Health Connect спрашивает обоснование другим
             action; alias ведёт на тот же экран приложения. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Health Connect: только ЧТЕНИЕ веса. Запись и данные цикла сюда не
         идут намеренно — цикл не покидает устройство. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Клиент Health Connect объявляет minSdk 26, у приложения 24. Вызовы
         закрыты проверкой Build.VERSION на рантайме, поэтому override
         безопасен и старые телефоны не отваливаются от установки. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <!-- Видимость пакетов (Android 11+): чтобы кнопка «Открыть приложение»
         могла найти и запустить установленные приложения по пакету.
         Запрос лаунчабельных приложений вместо QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- проверка, установлен ли Health Connect (до Android 14 это
             отдельное приложение) -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
