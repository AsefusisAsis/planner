# Шаблон. Скопируйте в keystore.properties (тот в .gitignore) и заполните.
# Пароли сюда вписываете ВЫ и никому не передаёте — в репозиторий этот файл
# не попадает.
#
# Ключ создаётся один раз командой (см. PLAY_CHECKLIST.md):
#   keytool -genkeypair -v -keystore planner-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias planner
#
# ПОТЕРЯ ЭТОГО ФАЙЛА И .jks = невозможность обновлять приложение в Play
# под тем же listing. Сделайте резервную копию в надёжном месте.

storeFile=planner-release.jks
storePassword=
keyAlias=planner
keyPassword=
